APP_HOST=0.0.0.0
APP_PORT=5013
LOG_LEVEL=INFO

# 物理核数（E5-2697 v3 = 14）
CPU_THREADS=14
OMP_NUM_THREADS=14
MKL_NUM_THREADS=14

# 离线
YOLO_OFFLINE=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# 数据与权重目录（Docker 内一般不用改）
# DATA_DIR=/app/data
# WEIGHTS_DIR=/app/weights

MAX_UPLOAD_MB=500
INFER_BATCH_SIZE=8
TRAIN_WORKERS=8
